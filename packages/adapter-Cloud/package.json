{
    "name": "@hybrid-ai/adapter-cloud",
    "version": "0.1.0",
    "description": "Cloud fallback adapter with OpenAI, Anthropic, and Gemini clients for hybrid-ai-router.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/codinoob1/hybrid-Ai-Router.git",
        "directory": "packages/adapter-Cloud"
    },
    "keywords": ["hybrid-ai", "openai", "anthropic", "gemini", "cloud", "llm"],
    "publishConfig": { "access": "public" },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts --clean",
        "test": "vitest run"
    },
    "dependencies": {
        "@hybrid-ai/core": "workspace:*",
        "openai": "^7.20.0"
    }
}